@{
    ViewBag.Title = "لوحة التحكم";
}

<h2 class="mb-4"><i class="fas fa-tachometer-alt"></i> لوحة التحكم</h2>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <i class="fas fa-map-marked-alt fa-2x mb-2"></i>
                <h5>المحافظات</h5>
                <h2>@ViewBag.TotalGovernorates</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary">
            <div class="card-body text-center">
                <i class="fas fa-landmark fa-2x mb-2"></i>
                <h5>المعالم</h5>
                <h2>@ViewBag.TotalAttractions</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-info">
            <div class="card-body text-center">
                <i class="fas fa-hotel fa-2x mb-2"></i>
                <h5>الفنادق</h5>
                <h2>@ViewBag.TotalHotels</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning">
            <div class="card-body text-center">
                <i class="fas fa-utensils fa-2x mb-2"></i>
                <h5>المطاعم</h5>
                <h2>@ViewBag.TotalRestaurants</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-secondary">
            <div class="card-body text-center">
                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                <h5>الفعاليات</h5>
                <h2>@ViewBag.TotalEvents</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-dark">
            <div class="card-body text-center">
                <i class="fas fa-users fa-2x mb-2"></i>
                <h5>المستخدمين</h5>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-danger">
            <div class="card-body text-center">
                <i class="fas fa-bookmark fa-2x mb-2"></i>
                <h5>الحجوزات</h5>
                <h2>@ViewBag.TotalBookings</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <i class="fas fa-star fa-2x mb-2"></i>
                <h5>التقييمات</h5>
                <h2>@ViewBag.TotalReviews</h2>
            </div>
        </div>
    </div>
</div>