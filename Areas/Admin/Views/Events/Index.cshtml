@model List<Event>
@{
    ViewBag.Title = "إدارة الفعاليات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-alt"></i> إدارة الفعاليات</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> إضافة فعالية</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>المحافظة</th>
            <th>تاريخ البدء</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var evt in Model)
        {
            <tr>
                <td>@evt.Id</td>
                <td>@evt.Name</td>
                <td>@evt.Governorate?.Name</td>
                <td>@evt.StartDate.ToString("yyyy/MM/dd")</td>
                <td><span class="badge @(evt.Status == "قادم" ? "bg-success" : "bg-secondary")">@evt.Status</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@evt.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                    <a asp-action="Delete" asp-route-id="@evt.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>