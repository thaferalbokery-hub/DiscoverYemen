@model List<Governorate>
@{
    ViewBag.Title = "إدارة المحافظات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-map-marked-alt"></i> إدارة المحافظات</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> إضافة محافظة</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>الوصف</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var gov in Model)
        {
            <tr>
                <td>@gov.Id</td>
                <td>@gov.Name</td>
                <td>@(gov.Description?.Length > 50 ? gov.Description.Substring(0, 50) + "..." : gov.Description)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@gov.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                    <a asp-action="Delete" asp-route-id="@gov.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>