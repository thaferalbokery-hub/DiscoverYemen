@model List<Restaurant>
@{
    ViewBag.Title = "إدارة المطاعم";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-utensils"></i> إدارة المطاعم</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> إضافة مطعم</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>المحافظة</th>
            <th>نوع المطبخ</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Name</td>
                <td>@r.Governorate?.Name</td>
                <td>@r.CuisineType</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>