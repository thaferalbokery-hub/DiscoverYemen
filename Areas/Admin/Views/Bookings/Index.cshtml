@model List<Booking>
@{
    ViewBag.Title = "إدارة الحجوزات";
}

<h2 class="mb-4"><i class="fas fa-bookmark"></i> إدارة الحجوزات</h2>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>المستخدم</th>
            <th>تاريخ الحجز</th>
            <th>العناصر</th>
            <th>الحالة</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Id</td>
                <td>@booking.User?.FullName</td>
                <td>@booking.BookingDate.ToString("yyyy/MM/dd")</td>
                <td>
                    @foreach (var item in booking.BookingItems)
                    {
                        <span class="badge bg-info">@item.ItemName</span>
                    }
                </td>
                <td><span class="badge bg-success">@booking.Status</span></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا توجد حجوزات</div>
}