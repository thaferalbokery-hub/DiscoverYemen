@model AttractionEditViewModel
@{
    ViewBag.Title = "تعديل المعلم";
}

<h2><i class="fas fa-edit"></i> تعديل المعلم</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GovernorateId" class="form-label"></label>
                <select asp-for="GovernorateId" class="form-select" asp-items="@(ViewBag.Governorates as SelectList)">
                    <option value="">-- اختر المحافظة --</option>
                </select>
                <span asp-validation-for="GovernorateId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">التصنيفات</label>
                @foreach (var cat in (List<Category>)ViewBag.Categories)
                {
                    <div class="form-check">
                        <input type="checkbox" name="SelectedCategoryIds" value="@cat.Id" class="form-check-input" id="cat_@cat.Id"
                               @(Model.SelectedCategoryIds.Contains(cat.Id) ? "checked" : "") />
                        <label class="form-check-label" for="cat_@cat.Id">@cat.Name</label>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
            {
                <div class="mb-3">
                    <label class="form-label">الصورة الحالية</label>
                    <div>
                        <img src="@Model.ExistingImageUrl" alt="الصورة الحالية" style="max-height: 150px;" class="rounded" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label">صورة جديدة (اختياري)</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}