@model Attraction
@{
    ViewBag.Title = "حذف المعلم";
}

<h2 class="text-danger"><i class="fas fa-trash"></i> حذف المعلم</h2>

<div class="alert alert-warning">
    <strong>تحذير!</strong> هل أنت متأكد من حذف هذا المعلم؟ لا يمكن التراجع عن هذا الإجراء.
</div>

<div class="card">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <p><strong>المحافظة:</strong> @Model.Governorate?.Name</p>
        <p><strong>الوصف:</strong> @Model.Description</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> تأكيد الحذف</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </form>
    </div>
</div>