@model List<Event>
@{
    ViewBag.Title = "الفعاليات";
}

<h2 class="mb-4"><i class="fas fa-calendar-alt"></i> الفعاليات</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">-- كل الحالات --</option>
                <option value="قادم" selected="@(ViewData["CurrentStatus"]?.ToString() == "قادم")">قادم</option>
                <option value="منتهي" selected="@(ViewData["CurrentStatus"]?.ToString() == "منتهي")">منتهي</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-filter"></i> تصفية</button>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var evt in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@evt.Name</h5>
                    <p class="text-muted"><i class="fas fa-map-marker-alt"></i> @evt.Governorate?.Name</p>
                    <p><i class="fas fa-calendar"></i> @evt.StartDate.ToString("yyyy/MM/dd")</p>
                    @if (!string.IsNullOrEmpty(evt.Status))
                    {
                        <span class="badge @(evt.Status == "قادم" ? "bg-success" : "bg-secondary")">@evt.Status</span>
                    }
                    <p class="card-text mt-2">@evt.Description</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@evt.Id" class="btn btn-primary btn-sm">عرض التفاصيل</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا توجد فعاليات</div>
}