@model Event
@{
    ViewBag.Title = Model.Name;
}

<h2><i class="fas fa-calendar-alt"></i> @Model.Name</h2>

<div class="card">
    <div class="card-body">
        <p><strong>المحافظة:</strong> @Model.Governorate?.Name</p>
        <p><strong>الموقع:</strong> @Model.Location</p>
        <p><strong>تاريخ البدء:</strong> @Model.StartDate.ToString("yyyy/MM/dd")</p>
        @if (Model.EndDate.HasValue)
        {
            <p><strong>تاريخ الانتهاء:</strong> @Model.EndDate.Value.ToString("yyyy/MM/dd")</p>
        }
        <p><strong>الحالة:</strong> <span class="badge @(Model.Status == "قادم" ? "bg-success" : "bg-secondary")">@Model.Status</span></p>
        <p><strong>الوصف:</strong> @Model.Description</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Bookings" asp-action="Create" method="post" class="mt-3">
                <input type="hidden" name="ItemType" value="Event" />
                <input type="hidden" name="ItemId" value="@Model.Id" />
                <input type="hidden" name="ItemName" value="@Model.Name" />
                <input type="hidden" name="Quantity" value="1" />
                <button type="submit" class="btn btn-success"><i class="fas fa-bookmark"></i> احجز الآن</button>
            </form>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">العودة للفعاليات</a>