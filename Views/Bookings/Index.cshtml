@model List<Booking>
@{
    ViewBag.Title = "حجوزاتي";
}

<h2 class="mb-4"><i class="fas fa-bookmark"></i> حجوزاتي</h2>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-success">
            <tr>
                <th>#</th>
                <th>تاريخ الحجز</th>
                <th>العناصر</th>
                <th>الحالة</th>
                <th>ملاحظات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.BookingDate.ToString("yyyy/MM/dd")</td>
                    <td>
                        @foreach (var item in booking.BookingItems)
                        {
                            <span class="badge bg-info">@item.ItemName (@item.ItemType)</span>
                        }
                    </td>
                    <td><span class="badge bg-success">@booking.Status</span></td>
                    <td>@booking.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">
        <p>لا توجد حجوزات</p>
        <a asp-controller="Attractions" asp-action="Index" class="btn btn-success">تصفح المعالم</a>
    </div>
}