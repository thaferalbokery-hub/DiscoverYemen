@model (string Title, string Value, string Icon, string Color)
<div class="col-md-3 col-sm-6 mb-3">
    <div class="card text-white bg-@Model.Color h-100">
        <div class="card-body text-center">
            <i class="fas fa-@Model.Icon fa-2x mb-2"></i>
            <h5 class="card-title">@Model.Title</h5>
            <h2 class="card-text">@Model.Value</h2>
        </div>
    </div>
</div>