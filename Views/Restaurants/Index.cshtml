@model List<Restaurant>
@{
    ViewBag.Title = "المطاعم";
}

<h2 class="mb-4"><i class="fas fa-utensils"></i> المطاعم</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <select name="governorateId" class="form-select" asp-items="@(ViewBag.Governorates as SelectList)">
                <option value="">-- كل المحافظات --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-filter"></i> تصفية</button>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var restaurant in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@restaurant.Name</h5>
                    <p class="text-muted"><i class="fas fa-map-marker-alt"></i> @restaurant.Governorate?.Name</p>
                    @if (!string.IsNullOrEmpty(restaurant.CuisineType))
                    {
                        <span class="badge bg-warning text-dark">@restaurant.CuisineType</span>
                    }
                    <p class="card-text mt-2">@restaurant.Description</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@restaurant.Id" class="btn btn-warning btn-sm">عرض التفاصيل</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا توجد مطاعم</div>
}