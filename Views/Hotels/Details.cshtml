@model Hotel
@{
    ViewBag.Title = Model.Name;
}

<h2><i class="fas fa-hotel"></i> @Model.Name</h2>

<div class="card">
    <div class="card-body">
        <p><strong>المحافظة:</strong> @Model.Governorate?.Name</p>
        <p><strong>العنوان:</strong> @Model.Address</p>
        <p><strong>الهاتف:</strong> @Model.Phone</p>
        @if (Model.Stars.HasValue)
        {
            <p><strong>التصنيف:</strong>
                <span class="text-warning">
                    @for (int i = 0; i < Model.Stars.Value; i++)
                    {
                        <i class="fas fa-star"></i>
                    }
                </span>
            </p>
        }
        <p><strong>الوصف:</strong> @Model.Description</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Bookings" asp-action="Create" method="post" class="mt-3">
                <input type="hidden" name="ItemType" value="Hotel" />
                <input type="hidden" name="ItemId" value="@Model.Id" />
                <input type="hidden" name="ItemName" value="@Model.Name" />
                <input type="hidden" name="Quantity" value="1" />
                <button type="submit" class="btn btn-success"><i class="fas fa-bookmark"></i> احجز الآن</button>
            </form>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">العودة للفنادق</a>