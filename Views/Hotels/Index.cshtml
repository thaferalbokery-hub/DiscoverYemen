@model List<Hotel>
@{
    ViewBag.Title = "الفنادق";
}

<h2 class="mb-4"><i class="fas fa-hotel"></i> الفنادق</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <select name="governorateId" class="form-select" asp-items="@(ViewBag.Governorates as SelectList)">
                <option value="">-- كل المحافظات --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-filter"></i> تصفية</button>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var hotel in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@hotel.Name</h5>
                    <p class="text-muted"><i class="fas fa-map-marker-alt"></i> @hotel.Governorate?.Name</p>
                    @if (hotel.Stars.HasValue)
                    {
                        <p class="text-warning">
                            @for (int i = 0; i < hotel.Stars.Value; i++)
                            {
                                <i class="fas fa-star"></i>
                            }
                        </p>
                    }
                    <p class="card-text">@hotel.Description</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@hotel.Id" class="btn btn-info btn-sm">عرض التفاصيل</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا توجد فنادق</div>
}