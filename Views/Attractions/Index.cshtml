@model List<AttractionListViewModel>
@{
    ViewBag.Title = "المعالم السياحية";
}

<h2 class="mb-4"><i class="fas fa-landmark"></i> المعالم السياحية</h2>

<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="searchTerm" class="form-control" placeholder="ابحث بالاسم..." value="@ViewData["CurrentSearch"]" />
        </div>
        <div class="col-md-3">
            <select name="governorateId" class="form-select" asp-items="@(ViewBag.Governorates as SelectList)">
                <option value="">-- كل المحافظات --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" asp-items="@(ViewBag.Categories as SelectList)">
                <option value="">-- كل التصنيفات --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100"><i class="fas fa-search"></i> بحث</button>
        </div>
    </div>
</form>

<div class="row">
    @foreach (var attraction in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(attraction.ImageUrl))
                {
                    <img src="@attraction.ImageUrl" class="card-img-top" alt="@attraction.Name" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="fas fa-image fa-3x text-white"></i>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@attraction.Name</h5>
                    <p class="text-muted"><i class="fas fa-map-marker-alt"></i> @attraction.GovernorateName</p>
                    @if (attraction.Categories.Any())
                    {
                        <p>
                            @foreach (var cat in attraction.Categories)
                            {
                                <span class="badge bg-info">@cat</span>
                            }
                        </p>
                    }
                    <p class="card-text">@(attraction.Description?.Length > 80 ? attraction.Description.Substring(0, 80) + "..." : attraction.Description)</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@attraction.Id" class="btn btn-success btn-sm">عرض التفاصيل</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا توجد نتائج</div>
}